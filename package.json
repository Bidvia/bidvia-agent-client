{
  "name": "bidvia-agent-client",
  "version": "0.1.0",
  "private": false,
  "description": "Open-source-ready Bidvia agent access client toolkit scaffold.",
  "type": "module",
  "bin": {
    "bidvia-agent-client": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "tsx --test test/**/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "tsx scripts/validate-contract.ts",
    "example": "tsx examples/basic-agent.ts",
    "example:internal": "tsx examples/internal-team-agent.ts",
    "example:seed": "tsx examples/seed-user-agent.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
